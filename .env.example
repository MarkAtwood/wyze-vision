# The snapshot loop itself needs NO secrets: the Wyze tokens are read at runtime
# from the mounted /config/.storage/core.config_entries (the ha-wyzeapi config
# entry), so there is no Wyze password / HA token to configure.
#
# Two OPTIONAL secrets, each gating an opt-in feature; unset either and that
# feature disables itself (the sidecar stays secretless by default):
#
# 1. MQTT_PASS -- the dedicated 'wyzesnap' broker user's password, enabling the
#    Wyze cloud conn-state bridge (Hassio-708): retained wyze/<mac>/status
#    publishing. Host/user/port are non-secret and live in docker-compose.yml.
#
# MQTT_PASS=<wyzesnap broker password>   # macOS Keychain svc mqtt-wyzesnap-password
#
# 2. HA_TOKEN -- a Home Assistant long-lived access token named 'wyze-snapshot',
#    enabling the event-driven fast path (Hassio-i0w): on a wyze_camera_event
#    the sidecar grabs a fresh still for that one camera immediately instead of
#    waiting up to REFRESH_SECONDS. HA_URL is non-secret (docker-compose.yml).
#
# HA_TOKEN=<HA long-lived access token>  # HA profile -> Long-Lived Access Tokens
#
# Tunables (otherwise set in docker-compose.yml):
# REFRESH_SECONDS=600     # snapshot cycle; MUST stay < 1800 (KVS cred lifetime)
# FRAME_TIMEOUT=30        # per-camera frame.jpeg HTTP timeout (s)
# FRAME_ATTEMPTS=3        # retries while go2rtc establishes the KVS connection
# GO2RTC_SETTLE=5         # grace after (re)starting go2rtc before pulling frames
