# This sidecar needs NO secrets: the Wyze tokens are read at runtime from the
# mounted /config/.storage/core.config_entries (the ha-wyzeapi config entry), so
# there is no Wyze password / HA token to configure. An .env is OPTIONAL and only
# useful to override the tunables below (otherwise set in docker-compose.yml).
#
# REFRESH_SECONDS=600     # snapshot cycle; MUST stay < 1800 (KVS cred lifetime)
# FRAME_TIMEOUT=30        # per-camera frame.jpeg HTTP timeout (s)
# FRAME_ATTEMPTS=3        # retries while go2rtc establishes the KVS connection
# GO2RTC_SETTLE=5         # grace after (re)starting go2rtc before pulling frames
